{
  "expo": {
    "name": "Shelf",
    "slug": "hatch-shelf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jarvis.shelf",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "书巢",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Zip Archive",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "public.zip-archive"
            ]
          },
          {
            "CFBundleTypeName": "Markdown",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": [
              "net.daringfireball.markdown"
            ]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown",
            "UTTypeConformsTo": [
              "public.plain-text"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "md",
                "markdown"
              ],
              "public.mime-type": [
                "text/markdown"
              ]
            }
          }
        ],
        "LSSupportsOpeningDocumentsInPlace": false,
        "NSLocalNetworkUsageDescription": "用于在同一 Wi-Fi 下从电脑向书巢传书"
      },
      "appleTeamId": "9RHJ3C776D"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jarvis.shelf"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "shelf",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E9ECF3",
          "dark": {
            "backgroundColor": "#E9ECF3"
          }
        }
      ]
    ]
  }
}

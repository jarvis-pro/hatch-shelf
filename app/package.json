{
  "name": "app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@shelf/spec": "workspace:*",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build:reader": "pnpm --filter @shelf/reader-web build",
    "build:samples": "node scripts/build-samples.mjs",
    "build:assets": "pnpm build:reader && pnpm build:samples",
    "start": "pnpm build:assets && expo start --dev-client",
    "ios": "pnpm build:assets && expo run:ios",
    "android": "pnpm build:assets && expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "pnpm build:samples && tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor"
  },
  "private": true
}

{
  "name": "@shelf/dock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "电脑端控制台：读本地书库，与手机比对后勾选推送（README 第 5.2 节）",
  "scripts": {
    "start": "vite build && tsx server/main.ts",
    "dev": "tsx watch server/main.ts --dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@shelf/library": "workspace:*",
    "@shelf/spec": "workspace:*",
    "lucide-react": "^1.69.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}

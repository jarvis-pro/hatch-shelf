{
  "name": "@shelf/mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@shelf/spec": "workspace:*",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-router": "~58.0.29",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "fflate": "^0.8.3",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-tcp-socket": "^6.4.3",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "build:reader": "node ../../packages/reader/build.mjs assets/reader/index.html",
    "build:samples": "node scripts/build-samples.mjs",
    "build:assets": "pnpm build:reader && pnpm build:samples",
    "start": "pnpm build:assets && expo start --dev-client",
    "ios": "pnpm build:assets && expo prebuild --platform ios && expo run:ios",
    "android": "pnpm build:assets && expo prebuild --platform android && expo run:android",
    "prebuild": "expo prebuild --clean",
    "testflight": "node scripts/testflight.mjs",
    "typecheck": "pnpm build:samples && tsc --noEmit",
    "lint": "expo lint",
    "doctor": "expo-doctor",
    "test": "vitest run src"
  },
  "private": true
}

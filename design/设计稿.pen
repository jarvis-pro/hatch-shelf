        },
        {
          "type": "text",
          "id": "ejeEd",
          "name": "t",
          "fill": "#555049",
          "textGrowth": "fixed-width",
          "width": "fill_container",
          "content": "设置 →「书库」→ 书籍管理，专为批量操作：按分类分组，配圆环扫描动画。\n\n页面常驻勾选态，分类标题可整类勾选，右上角「全选」；选中后底部出现删除按钮。每行显示封面、书名、大小，以及阅读状态和笔记数，方便判断删除会丢掉什么。\n\n进入即可勾选，大小异步统计：圆环彗星旋转、图例与每行大小为骨架，每完成一类扫入一段颜色。统计完成前「按大小」排序置灰。结果缓存，下次进入直接显示并静默刷新。",
          "lineHeight": 1.7,
          "fontFamily": "Noto Sans SC",
          "fontSize": 14,
          "fontWeight": "normal"
        }
      ]
    },
